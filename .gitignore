# Secrets — never commit
.env
*.key
secrets.json
gphotos_client_secret.json
.gphotos_token.json

# Machine-local tool state (contains local paths, not meant to be shared)
.claude/
hf_cache/
_model_cache/

# Large binaries that live on Drive, not in git
*.zip
*.msix
*.exe
_archive/
*.pdf
*.docx
*.xlsx
*.m4a
*.mp3
*.mp4

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# The knowledge vault — personal data (photos, events, notes), never in git
vault/

# Generated vault artefacts
processed/*.html
*.corrupt.*

# Built corpora and embedding indexes.
# Derived from the source PDFs by notebook/corpus.py, so rebuildable — and they
# contain the full extracted text of copyrighted textbooks, which must not end
# up in git history. They live under vault/corpora/ (covered by the vault/
# rule); the patterns below are belt-and-suspenders.
*.jsonl
*.sqlite
*.npy

# Portal (Firebase) secrets
firebase_admin_key.json
.portal_sync_state.json
